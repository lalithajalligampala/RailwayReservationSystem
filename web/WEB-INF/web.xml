<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <!-- Graph -->

    <servlet>
        <servlet-name>GraphServlet</servlet-name>
        <servlet-class>com.railway.servlet.GraphServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>GraphServlet</servlet-name>
        <url-pattern>/graph</url-pattern>
    </servlet-mapping>


    <!-- Train Details -->

    <servlet>
        <servlet-name>TrainDetailsServlet</servlet-name>
        <servlet-class>com.railway.servlet.TrainDetailsServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>TrainDetailsServlet</servlet-name>
        <url-pattern>/trainDetails</url-pattern>
    </servlet-mapping>


    <!-- Test Database Connection -->

    <servlet>
        <servlet-name>TestDBServlet</servlet-name>
        <servlet-class>com.railway.servlet.TestDBServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>TestDBServlet</servlet-name>
        <url-pattern>/testdb</url-pattern>
    </servlet-mapping>


    <!-- Search Train -->

    <servlet>
        <servlet-name>SearchTrainServlet</servlet-name>
        <servlet-class>com.railway.servlet.SearchTrainServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>SearchTrainServlet</servlet-name>
        <url-pattern>/searchTrain</url-pattern>
    </servlet-mapping>


    <!-- Book Ticket -->

    <servlet>
        <servlet-name>BookTicketServlet</servlet-name>
        <servlet-class>com.railway.servlet.BookTicketServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>BookTicketServlet</servlet-name>
        <url-pattern>/bookTicket</url-pattern>
    </servlet-mapping>


    <!-- PNR Status -->

    <servlet>
        <servlet-name>PNRServlet</servlet-name>
        <servlet-class>com.railway.servlet.PNRServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>PNRServlet</servlet-name>
        <url-pattern>/pnr</url-pattern>
    </servlet-mapping>


    <!-- Cancel Ticket -->

    <servlet>
        <servlet-name>CancelTicketServlet</servlet-name>
        <servlet-class>com.railway.servlet.CancelTicketServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CancelTicketServlet</servlet-name>
        <url-pattern>/cancelTicket</url-pattern>
    </servlet-mapping>


    <!-- Waiting List -->

    <servlet>
        <servlet-name>WaitingListServlet</servlet-name>
        <servlet-class>com.railway.servlet.WaitingListServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>WaitingListServlet</servlet-name>
        <url-pattern>/waitingList</url-pattern>
    </servlet-mapping>


    <!-- Dashboard -->

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.railway.servlet.DashboardServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>


    <!-- View All Trains -->

    <servlet>
        <servlet-name>ViewTrainServlet</servlet-name>
        <servlet-class>com.railway.servlet.ViewTrainServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ViewTrainServlet</servlet-name>
        <url-pattern>/viewTrains</url-pattern>
    </servlet-mapping>
        <!-- Admin Authentication Filter -->

    <filter>
        <filter-name>AdminAuthFilter</filter-name>
        <filter-class>com.railway.servlet.AdminAuthFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/admin.html</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/addTrain</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/updateTrain</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/deleteTrain</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/viewTrains</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/viewBookings</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/dashboard</url-pattern>
    </filter-mapping>


    <!-- Welcome Page -->

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
    <servlet>
    <servlet-name>AddTrainServlet</servlet-name>
    <servlet-class>com.railway.servlet.AddTrainServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>AddTrainServlet</servlet-name>
    <url-pattern>/addTrain</url-pattern>
</servlet-mapping>
<servlet>
    <servlet-name>ViewBookingsServlet</servlet-name>
    <servlet-class>com.railway.servlet.ViewBookingsServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>ViewBookingsServlet</servlet-name>
    <url-pattern>/viewBookings</url-pattern>
</servlet-mapping>
<servlet>
    <servlet-name>UpdateTrainServlet</servlet-name>
    <servlet-class>com.railway.servlet.UpdateTrainServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>UpdateTrainServlet</servlet-name>
    <url-pattern>/updateTrain</url-pattern>
</servlet-mapping>
<servlet>
    <servlet-name>DeleteTrainServlet</servlet-name>
    <servlet-class>com.railway.servlet.DeleteTrainServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>DeleteTrainServlet</servlet-name>
    <url-pattern>/deleteTrain</url-pattern>
</servlet-mapping>
<servlet>
    <servlet-name>BinarySearchServlet</servlet-name>
    <servlet-class>com.railway.servlet.BinarySearchServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>BinarySearchServlet</servlet-name>
    <url-pattern>/binarySearch</url-pattern>
</servlet-mapping>
<servlet>
    <servlet-name>MergeSortServlet</servlet-name>
    <servlet-class>com.railway.servlet.MergeSortServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>MergeSortServlet</servlet-name>
    <url-pattern>/mergeSort</url-pattern>
</servlet-mapping>
<servlet>
    <servlet-name>SeatAvailabilityServlet</servlet-name>
    <servlet-class>com.railway.servlet.SeatAvailabilityServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>SeatAvailabilityServlet</servlet-name>
    <url-pattern>/seatAvailability</url-pattern>
</servlet-mapping>
<servlet>
    <servlet-name>WaitingQueueServlet</servlet-name>
    <servlet-class>com.railway.servlet.WaitingQueueServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>WaitingQueueServlet</servlet-name>
    <url-pattern>/waitingQueue</url-pattern>
</servlet-mapping>
    <!-- Admin Logout -->

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.railway.servlet.LogoutServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

</web-app>